# MeshAgent environment template
# Copy to .env for local development. For production, inject values through your
# secrets/configuration platform and never commit the resulting file.

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
MESHAGENT_ENV=development
MESHAGENT_ENGINE=1
MESHAGENT_DB_DIR=./var
MESHAGENT_CORS_ORIGINS=http://localhost:5173
MESHAGENT_WEB_URL=http://localhost:5173

# Without OIDC settings, local development uses explicitly unverified identity
# headers. Production startup rejects that mode.
# MESHAGENT_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# MESHAGENT_OIDC_AUDIENCE=meshagent-api
# MESHAGENT_OIDC_CLIENT_ID=meshagent-web
# MESHAGENT_OIDC_SCOPE=openid profile email
# MESHAGENT_OIDC_ROLE_CLAIM=roles
# MESHAGENT_ANALYST_GROUPS=meshagent-security
# MESHAGENT_OIDC_JWKS_URL=https://login.example.com/tenant/discovery/v2.0/keys

# -----------------------------------------------------------------------------
# Production-required settings
# -----------------------------------------------------------------------------
# MESHAGENT_ENV=production
# MESHAGENT_ENGINE=1
# MESHAGENT_DB_DIR=/var/lib/meshagent
# MESHAGENT_STRICT_AUDIT=true
# MESHAGENT_CORS_ORIGINS=https://meshagent.example.com
# MESHAGENT_WEB_URL=https://meshagent.example.com
# MESHAGENT_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# MESHAGENT_OIDC_AUDIENCE=meshagent-api
# MESHAGENT_OIDC_CLIENT_ID=meshagent-web
# MESHAGENT_OIDC_SCOPE=openid profile email
# MESHAGENT_OIDC_ROLE_CLAIM=roles
# MESHAGENT_ANALYST_GROUPS=meshagent-security

# Model-built runs. Without a key, the application clearly uses its reference
# build rather than implying that a live model executed the task.
# OPENAI_API_KEY=replace-through-secret-manager
# MESHAGENT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supply-chain feeds. Set to 0 for a deliberately offline deployment; responses
# then report lookups as unavailable rather than inventing package state.
MESHAGENT_FEEDS=1
MESHAGENT_FEED_TIMEOUT=6
