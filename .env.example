# Web (Vite) -- prefix VITE_ to expose to the browser
VITE_API_BASE=http://localhost:8000

# API
MESHAGENT_CORS_ORIGINS=http://localhost:5173
# When wiring the real engine, point these at your HyperMesh deployment.
# Leave unset to run the API on the built-in sample gateway.
# MESHAGENT_DB_DIR=/var/lib/meshagent/hypermesh

# Model-built runs. With a key set, a new run is carried out by the model and
# the memory that follows is its real work. Without one, runs record the
# reference build instead and every screen says so.
# OPENAI_API_KEY=sk-...
# MESHAGENT_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works: Azure gateways, vLLM, Ollama, OpenRouter.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supply-chain feeds: real versions from PyPI, real advisories from OSV.
# Set to 0 to run fully offline; lookups then report themselves unavailable
# rather than guessing a version.
# MESHAGENT_FEEDS=1
# MESHAGENT_FEED_TIMEOUT=6
