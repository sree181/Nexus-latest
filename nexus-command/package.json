{
  "name": "nexus-command",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite --host --port 4001\"",
    "dev:live": "VITE_API_PROXY_TARGET=https://nexus-api-production-9c79.up.railway.app vite --host --port 4001",
    "dev:frontend": "vite --host --port 4001",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "start": "node dist-server/index.js",
    "start:connector-worker": "node dist-server/connectors/worker.js",
    "build:server": "esbuild server/index.ts server/operational/migrate.ts server/connectors/worker.ts --bundle --platform=node --format=esm --outbase=server --outdir=dist-server --packages=external",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx server/operational/migrate.ts",
    "connectors:smoke": "ETA_SPOT_PRODUCTION_APPROVED=true tsx server/connectors/smoke.ts",
    "detection:dry-run": "tsx server/operational/detection/dryRun.ts",
    "dev:wall": "concurrently \"NEXUS_REPOSITORY=review NEXUS_AUTH_MODE=review PORT=4002 tsx server/index.ts\" \"vite --host --port 4001 --open /wall.html\"",
    "test:wall": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@xyflow/react": "^12.11.5",
    "cors": "^2.8.6",
    "d3-sankey": "^0.12.3",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "maplibre-gl": "^5.24.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@playwright/test": "^1.55.0",
    "@types/cors": "^2.8.19",
    "@types/d3-sankey": "^0.12.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
