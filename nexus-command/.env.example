# Persistent operational storage
DATABASE_URL=postgresql://nexus:replace-me@database.example/nexus
NEXUS_REPOSITORY=postgres
PGSSL=true
PGSSL_REJECT_UNAUTHORIZED=true

# Production identity
NEXUS_AUTH_MODE=oidc
NEXUS_OIDC_ISSUER=https://identity.example/
NEXUS_OIDC_AUDIENCE=nexus-api
NEXUS_OIDC_JWKS_URI=https://identity.example/.well-known/jwks.json
NEXUS_ALLOWED_ORIGINS=https://nexus.example

# Public authoritative connectors
ETA_SPOT_PRODUCTION_APPROVED=false
CONNECTOR_WORKER_TICK_MS=15000
CONNECTOR_RUN_TIMEOUT_MS=65000

# Optional live road-flow source
TOMTOM_API_KEY=

# Partner-gated contracts; placeholder adapter remains disabled until its agency schema is implemented
AUBURN_PARKING_API_URL=
AUBURN_PARKING_API_TOKEN=
EMERGENCY_ACCESS_WEBHOOK_SECRET=
